              "shortDescription": {
                "markdown": "CVE-2026-59875: node-tar: Uncaught Exception DoS via NUL byte in PAX path/linkpath records",
                "text": "CVE-2026-59875: node-tar: Uncaught Exception DoS via NUL byte in PAX path/linkpath records"
