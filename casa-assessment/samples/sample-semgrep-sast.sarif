{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/Sarif-2.1.0/rtm/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Semgrep OSS (CASA 3.0 AL1 Ruleset)",
          "version": "1.95.0",
          "rules": [
            {
              "id": "SAST-01-hardcoded-jwt-secret",
              "shortDescription": { "text": "SAST-01: Hardcoded credential or secret token in source" }
            },
            {
              "id": "SAST-04-weak-hash-md5",
              "shortDescription": { "text": "SAST-04: Weak hash function (MD5/SHA-1) used in security context" }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "SAST-01-hardcoded-jwt-secret",
          "level": "error",
          "message": {
            "text": "SAST-01 violation: Hardcoded API secret found in src/config/auth.js:18 (CWE-798)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/config/auth.js" },
                "region": { "startLine": 18 }
              }
            }
          ]
        }
      ]
    }
  ]
}
